% 图：项目总览（README 的"3 分钟版"）。
%
% ===== 最重要的设计原则：**图上只放不能变成文字的视觉信息** =====
%
% 前几版把解释性句子塞进图里，结果是"一屏小字"——读者要逐行读完才知道在说什么，
% 比直接读正文还累。**图的价值在于一眼能看出结构，文字的价值在于能精确表述**，
% 两件事混在一起会同时损失两者。
%
% 所以这张图只保留三类信息：
%   1. **结构**：朴素做法 vs 本项目，两行箭头一比就看出差别（多减了一项）；
%   2. **数字**：3% / 0.298 / 0.876x —— 数字放图上有量级感，放文字里只是字符串；
%   3. **标签**：每个框的短名字。
% 所有解释、因果、边界声明**都移到图注**（README 里就是图下面那段文字）。
%
% 画幅由 scripts/build_figures.py 实测，不在这里声明。
\begin{tikzpicture}[
  x=1cm, y=1cm,
  st/.style={draw=black!32, fill=white, rounded corners=2.5pt,
             line width=0.55pt, align=center, inner xsep=6pt, inner ysep=4.5pt,
             font=\small, text=black!88, minimum height=0.76cm},
  stw/.style={st, draw=black!20, text=black!45},           % 被否掉的那条路
  stc/.style={st, draw=cImu!60!black, fill=cImu!7, text=cImu!45!black},
  str/.style={st, draw=cRes!60!black, fill=cRes!7, text=cRes!45!black},
  ar/.style={-{Stealth[length=4.2pt,width=3.2pt]}, draw=black!50, line width=0.7pt},
  ard/.style={-{Stealth[length=4.2pt,width=3.2pt]}, draw=black!22, line width=0.6pt,
              densely dashed},
  af/.style={-{Stealth[length=4.2pt,width=3.2pt]}, draw=cImu!65!black,
             line width=0.8pt, dashed},
  rowlab/.style={font=\small\bfseries, text=black!60, anchor=west,
                 inner sep=0pt},
  % 图上唯一的自由文字：标签 + 数字。**不要在这里写句子。**
  tag/.style={font=\scriptsize, text=black!60, anchor=south},
  num/.style={font=\large\bfseries, text=cCam!62!black},
]

  % ========================= 第 1 行：朴素做法 =========================
  %
  % **上排刻意画成"一条被填满的宽带"**，而不是"框 → 框"。
  % 理由：原来两排都是"框 + 箭头 + 框"，形状完全一样，读者看到的是**两组长得
  % 相同的图形**——对比只能靠读框里的字。改成宽带之后，"全存"这件事在图形上
  % 就成立了（一切都流过去），而下面那排有三个框（因为多了减法），形状不同，
  % 对比一眼可见。
  % **“朴素做法”/“本项目”是行标题，必须写在各自那一行的上方**。
  %
  % 踩过的三个坑：
  %   ① 只写 `\node[rowlab]` 无标记——两个字孤零零浮在左边缘，不像标题；
  %   ② 加了下划线但仍与内容同 y（`at (-1.60, 0)`）——实测宽带 y12-102、
  %      标题 y42-72，两者**并排**，看上去像宽带旁边挂了个装饰词；
  %   ③ 放到内容上方时第二行上方只剩 1.26cm，还要塞 tag，装不下。
  %
  % 最终：把行标题统一放在**内容上方**（y = 行顶 + 0.42），
  % 并把第二行的 tag 相应下移，两者互不干扰。
  \node[rowlab] (l1) at (-1.60, 0.72) {朴素做法};
  \draw[black!35, line width=0.6pt] (l1.south west) -- (l1.south east);
  %
  % 第二行标题的 y：**tikz 的 y 向下为负，所以"在框上方"意味着 y 要比
  % 框中心更接近 0**。踩过这个坑：写成 -1.88 想放到"更上面"，实际因为
  % -1.88 < -1.72 而落到了**方框下方**，实测插进框里不显示。
  % 框中心 -1.72、半高 0.38，视觉上的"上边"在 tikz 里是 y = -1.34，
  % 所以标题取 -1.20（留 0.14cm 空隙）。
  \node[rowlab] (l2) at (-1.60, -1.10) {本项目};
  \draw[black!50, line width=0.9pt] (l2.south west) -- (l2.south east);
  \fill[black!7] (0.71, -0.42) rectangle (13.54, 0.42);
  \draw[black!25, line width=0.5pt] (0.71, -0.42) rectangle (13.54, 0.42);
  \node[font=\small, text=black!50] at (7.13, 0) {画面变了 $\rightarrow$ 全存};

  % 被自运动淹没：画成带内的杂波。
  %
  % **说明文字要放在带内**，不能挂在带右侧：原来写在 `at (13.74, 0)`
  % （带右缘外），结果它紧贴带边缘、看上去像是带的延伸部分。
  % 现在把它放在带的右端内部（带右缘 13.54，文字右锚 13.34）。
  %
  % 杂波图锚铺满整带左半（0.9-6.0），因为带中间偏右要留给两段文字：
  % “画面变了 → 全存”（居中 7.13）与“这些全被自运动淹没”（右4）。
  \foreach \x in {0.9, 1.5, 2.1, 2.7, 3.3, 3.9, 4.5, 5.1, 5.7} {
    \draw[black!28, line width=0.9pt] (\x, -0.22) -- (\x + 0.24, 0.22);
  }
  \node[font=\scriptsize, text=black!45, anchor=east] at (13.34, 0)
    {这些全被自运动淹没};

  % ========================= 两排之间的分隔 =========================
  % **不要在两排之间放文字标记**。原来放过一个"对比"，结果把两排切成了两段
  % 各 50px+ 的稀疏区——视觉上像"两块不相关的东西"，反而削弱了对比。
  % 分组该靠**间距**表达：两排之间留小间距（合成一组），它们与下面的数字条
  % 之间留大间距（分成两区）。间距本身就说明了"这两行是一对"。

  % ========================= 第 2 行：本项目 =========================
  % 与上排的间距 1.30cm：两排形成一组（上面宽带高 0.84cm，所以 1.30cm 的
  % 中心距 = 约 0.46cm 空际）。而它们与下面数字条的距离更大（见 \ny），
  % 靠**间距**分组。
  %
  % **运算符与方框尽量留够间距**：原来框距只有 0.6-0.7cm，而 `$-$`/`$=$`
  % 画在框的正中间——视觉上像"符号贴在框边上"。现在每个运算符两侧各留
  % 0.72cm（= 一个半角空格 + 符号本身宽），读起来才是"框 ⟶ 运算符 ⟶ 框"。
  \node[st] (b1) at (1.55, -1.72) {画面变了};
  \node[font=\normalsize, text=black!45] at (3.35, -1.72) {$-$};
  \node[stc] (b2) at (4.70, -1.72) {自运动};
  \node[font=\normalsize, text=black!45] at (6.50, -1.72) {$=$};
  \node[str] (b3) at (7.85, -1.72) {残差};
  %
  % **箭头长度必须跟方框尺寸成比例**：原来 `-- (13.35, ...)`，而 `b3.east`
  % 在 x≈8.9，纯箭头段长达 4.5cm（占整幅宽度的 40%+），视觉上是一条
  % 空白长带，把"残差"和"存 3%"拉成两个孤立端点。
  % 现在终点定在 12.15 —— 箭头本身 3.2cm，与上方 "画面变了 → 全存"
  % 的间距（1.0→14.6 中文字宽约 4.2cm）保持同一量级。
  \draw[ar] (b3.east) -- (12.15, -1.72);
  \node[st, draw=cRes!60!black, text=cRes!45!black] (b4) at (12.90, -1.72)
    {存 3\%};

  % tag 的位置：**这条链上下都没有空间**——方框高 0.76cm 占满了中心上下
  % 各 0.38cm，而 IMU 盒子在 -2.30 又在下方。所以 tag 只能放在
  % **方框之间的水平空隙**里，且要避开箭头所在的 y。
  %
  % 踩过的三个坑（都源于没先量可用空间）：
  %   ① `at (9.8, -1.32)`：与箭头同 y，文字被线穿过（实测中心重合，差 0.0px）；
  %   ② `at (9.8, -0.76)` 配 anchor=south：想放上方，但 0.76cm 的框已经占满
  %      中心上方 0.38cm，于是 tag 落进**方框内部**；
  %   ③ `at (9.8, -1.72)` 配 anchor=north：放下方，但箭头右段正好在
  %      y≈-1.55（= 框中心 − 半框高 + 线的位置），tag 又贴上了箭头。
  %
  % 最终方案：**把 tag 移到 "残差" 框的正上方**（x 对齐 b3），那里是
  % 上排宽带与下排方框之间的空白（实测无墨迹），确定可用。
  % tag 的 y：宽带底 -0.42 与下排框顶 -2.10 之间取中偏上 = -0.88。
  \node[tag, anchor=south, text=cRes!55!black] at (7.85, -0.88)
    {只留解释不了的变化};

  % IMU 副本：从下方喂进"自运动"（虚线 = 旁路，与其他图同一约定）
  \node[stc] (imu) at (4.70, -2.72) {IMU 陀螺};
  \draw[af] (imu.north) -- (b2.south);
  \node[font=\scriptsize, text=cImu!55!black, anchor=west] at (5.65, -2.72)
    {出厂自带 \ 0.032\,ms/帧};

  % ========================= 数字条（图上留数字，解释给图注）=========================
  % 与上面一组的间距拉大（-2.30 → -3.45 = 1.15cm 空际），形成第二区。
  %
  % x 坐标与上方元素**语义对齐**：第一项对 b1（采集层），第二项对 b3
  % （残差度量），第三项对 b4（真机残差）。b4 移动后这三项必须跟着走，
  % 否则数字会悬在对应方块的侧边空白里。
  \def\ny{-3.87}
  \foreach \x/\v/\lab in {%
    1.55/3\%/{采集层占 30\,fps 预算},%
    7.85/0.298/{合成 val AP（uniform 4$\times$ 0.145）},%
    12.90/0.876$\times$/{真机残差（原实现 1.308$\times$）}%
  } {
    \node[num] at (\x, \ny) {\v};
    \node[font=\scriptsize, text=black!55, anchor=north, align=center,
          text width=4.3cm] at (\x, \ny-0.34) {\lab};
  }

\end{tikzpicture}
